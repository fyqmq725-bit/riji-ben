{
  "appId": "com.rijiben.app",
  "appName": "日记本",
  "webDir": "www",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https",
    "allowNavigation": [
      "api.open-meteo.com",
      "geocoding-api.open-meteo.com",
      "api.openai.com",
      "api.anthropic.com"
    ]
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 900,
      "backgroundColor": "#2a1810",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#f2ece1"
    },
    "Keyboard": {
      "resize": "body",
      "style": "DARK"
    }
  }
}
